msgstr "Výstup klienta LibreSpeed se nepodařilo přečíst."

#: js/src/utils.js:105
msgid "The LibreSpeed client reported no result."
msgstr "Klient LibreSpeed nevrátil žádný výsledek."

#: js/src/utils.js:106
msgid "Skipped: another measurement was still running after 3 minutes of waiting."
msgstr "Přeskočeno: jiné měření neskončilo ani po 3 minutách čekání."

